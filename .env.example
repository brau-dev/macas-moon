# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/50671110261
NEXT_PUBLIC_CONTACT_EMAIL=macasmoonglamping@gmail.com

# Legacy Cloudbeds widget (not used by /reservar)
NEXT_PUBLIC_ONLINE_BOOKING_ENABLED=false
NEXT_PUBLIC_CLOUDBEDS_CALENDAR_ENABLED=false
NEXT_PUBLIC_CLOUDBEDS_PROPERTY_CODE=
NEXT_PUBLIC_CLOUDBEDS_DOMO_ROMANTICO_RID=
NEXT_PUBLIC_CLOUDBEDS_DOMO_AMPLIO_RID=

# Private OTA iCal exports. Keep these server-only.
ICAL_DOMO_ROMANTICO_AIRBNB_URL=
ICAL_DOMO_ROMANTICO_EXPEDIA_URL=
ICAL_DOMO_AMPLIO_AIRBNB_URL=
ICAL_DOMO_AMPLIO_EXPEDIA_URL=

# PostgreSQL. Apply db/001_reservations.sql before enabling bookings.
DATABASE_URL=
BOOKING_ENABLED=false
BOOKING_CURRENCY=USD
# Integer hundredths of BOOKING_CURRENCY; e.g. 12500 = USD 125.00/night.
# These must be the final customer-facing nightly prices, including applicable taxes/fees.
PRICE_DOMO_ROMANTICO_CENTS=
PRICE_DOMO_AMPLIO_CENTS=

# Test-only direct booking. Localhost works in npm run dev. A separate Netlify
# staging site additionally requires all BOOKING_TEST_* guards below.
# Generate a 64-character hex secret with: openssl rand -hex 32
NEXT_PUBLIC_BOOKING_TEST_MODE=false
BOOKING_TEST_MODE=false
BOOKING_TEST_SECRET=
BOOKING_TEST_SITE_URL=
BOOKING_TEST_SITE_ID=

# Each iCal export URL ends in /api/calendar/{dome}/{token}/calendar.ics.
# Generate independent tokens with: openssl rand -hex 32
ICAL_EXPORT_ROMANTICO_TOKEN=
ICAL_EXPORT_AMPLIO_TOKEN=

# Cloudflare Turnstile protects the public checkout from automated night holds.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tilopay hosted payment page. Keep disabled until merchant account and rates are verified.
TILOPAY_CHECKOUT_ENABLED=false
BOOKING_SITE_URL=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
TILOPAY_MERCHANT_ID=
TILOPAY_EXPECTED_ENVIRONMENT=Test

# Automated confirmation email via Resend; sender domain must be verified.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_REPLY_TO=

# Netlify scheduled payment/email reconciliation. Keep disabled in no-pay staging.
BOOKING_RECONCILE_ENABLED=false
BOOKING_RECONCILE_SECRET=
