# Contacto publico del sitio (opcional)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/50671110261
NEXT_PUBLIC_CONTACT_EMAIL=macasmoonglamping@gmail.com

# Integracion anterior de Cloudbeds (no usada por /reservar)
NEXT_PUBLIC_ONLINE_BOOKING_ENABLED=false
NEXT_PUBLIC_CLOUDBEDS_CALENDAR_ENABLED=false
NEXT_PUBLIC_CLOUDBEDS_PROPERTY_CODE=
NEXT_PUBLIC_CLOUDBEDS_DOMO_ROMANTICO_RID=
NEXT_PUBLIC_CLOUDBEDS_DOMO_AMPLIO_RID=

# iCal de entrada: enlaces PRIVADOS que exportan Airbnb y Expedia.
# Cada anuncio debe corresponder al domo indicado. No subir valores reales a Git.
ICAL_DOMO_ROMANTICO_AIRBNB_URL=
ICAL_DOMO_ROMANTICO_EXPEDIA_URL=
ICAL_DOMO_AMPLIO_AIRBNB_URL=
ICAL_DOMO_AMPLIO_EXPEDIA_URL=

# Base de datos: Netlify Database aporta NETLIFY_DB_URL automaticamente.
# DATABASE_URL solo se usa con PostgreSQL local o externo.
DATABASE_URL=

# Reservas directas
BOOKING_ENABLED=false
# Omite esta variable o usa ambos slugs para habilitar los dos domos; en pruebas usa solo domo-amplio.
BOOKING_ACTIVE_DOMES=domo-romantico,domo-amplio
BOOKING_CURRENCY=USD
# Enteros en centavos de la moneda elegida; 12500 = USD 125 por noche.
PRICE_DOMO_ROMANTICO_CENTS=
PRICE_DOMO_AMPLIO_CENTS=

# Pruebas sin cobro: habilitar SOLO en un sitio Netlify separado o en localhost.
# La clave impide que visitantes creen reservas gratis y bloqueen anuncios reales.
# Generar con: openssl rand -hex 32
NEXT_PUBLIC_BOOKING_TEST_MODE=false
BOOKING_TEST_SECRET=

# iCal de salida: no requiere variables ni tokens. Se publica en:
# /api/calendar/domo-romantico/calendar.ics
# /api/calendar/domo-amplio/calendar.ics
# Los feeds solo contienen noches de reservas confirmadas, sin datos del huesped.

# Cobro real: mantener desactivado durante pruebas iCal sin pago.
# Netlify proporciona automaticamente URL para el retorno de pago.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TILOPAY_CHECKOUT_ENABLED=false
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
TILOPAY_MERCHANT_ID=
TILOPAY_EXPECTED_ENVIRONMENT=Test

# Correo automatico de confirmacion (opcional durante pruebas)
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
BOOKING_REPLY_TO=

# Conciliacion programada de pagos (desactivada durante pruebas sin pago)
BOOKING_RECONCILE_ENABLED=false
BOOKING_RECONCILE_SECRET=
